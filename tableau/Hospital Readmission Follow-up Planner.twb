      <column caption='Net Benefit (Random)' datatype='real' name='[Calculation_1926945284407301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[called] / [total_encounters] * 1000&#13;&#10; * ([base_rate] * [Parameters].[Parameter 1926945284067330]/100 * [Parameters].[Parameter 1926945283260416] - [Parameters].[Parameter 1926945283837953])' />
      </column>
      <column caption='Prevented per 1,000' datatype='real' name='[Calculation_1926945284472838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1926945284067330]/100 * [readmits_reached] / [total_encounters] * 1000' />

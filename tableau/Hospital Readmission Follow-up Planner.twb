    <worksheet name='Net benefit curve'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Net benefit per 1,000 discharges ($)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='policy_curve' name='federated.1w4dy8t02gdxgc1dit9b01vthalj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cost Readmit' datatype='integer' name='[Parameter 1926945283260416]' param-domain-type='range' role='measure' type='quantitative' value='15000'>
              <calculation class='tableau' formula='15000' />
              <range granularity='500' max='50000' min='1000' />
            </column>
            <column caption='Cost Per Patient' datatype='integer' name='[Parameter 1926945283837953]' param-domain-type='range' role='measure' type='quantitative' value='200'>
              <calculation class='tableau' formula='200' />
              <range granularity='10' max='2000' min='10' />
            </column>
            <column caption='Effect %' datatype='integer' name='[Parameter 1926945284067330]' param-domain-type='range' role='measure' type='quantitative' value='20'>
              <calculation class='tableau' formula='20' />
              <range granularity='1' max='50' min='0' />
            </column>
            <column caption='Capacity %' datatype='integer' name='[Parameter 1926945284206595]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range granularity='1' max='100' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w4dy8t02gdxgc1dit9b01vthalj'>
            <column caption='Net Benefit (Model)' datatype='real' name='[Calculation_1926945284325380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Parameters].[Parameter 1926945284067330]/100 * [readmits_reached] * [Parameters].[Parameter 1926945283260416]&#13;&#10; - [called] * [Parameters].[Parameter 1926945283837953]) / [total_encounters] * 1000' />
            </column>
            <column caption='Net Benefit (Random)' datatype='real' name='[Calculation_1926945284407301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[called] / [total_encounters] * 1000&#13;&#10; * ([base_rate] * [Parameters].[Parameter 1926945284067330]/100 * [Parameters].[Parameter 1926945283260416] - [Parameters].[Parameter 1926945283837953])' />
            </column>
            <column caption='Base Rate' datatype='real' name='[base_rate]' role='measure' type='quantitative' />
            <column caption='Called' datatype='integer' name='[called]' role='measure' type='quantitative' />
            <column-instance column='[share_called_pct]' derivation='None' name='[none:share_called_pct:qk]' pivot='key' type='quantitative' />

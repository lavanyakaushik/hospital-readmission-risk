          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w4dy8t02gdxgc1dit9b01vthalj'>
            <column caption='Net Benefit (Model)' datatype='real' name='[Calculation_1926945284325380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Parameters].[Parameter 1926945284067330]/100 * [readmits_reached] * [Parameters].[Parameter 1926945283260416]&#13;&#10; - [called] * [Parameters].[Parameter 1926945283837953]) / [total_encounters] * 1000' />
